---
import Layout from "@/layouts/Layout.astro";
import GlassHeader from "@/components/GlassHeader";
import CaseStudyGrid from "@/components/CaseStudyGrid.astro";
import Footer from "@/components/Footer.astro";
import { publishedCaseStudies } from "@/lib/data";
import { absoluteUrl, allCaseStudyNodes, breadcrumbNode, caseStudyPath } from "@/lib/schema";

const title = "Case studies: AI & behavioral products by Sina Dehesh";
const description = `Executive case studies of ${publishedCaseStudies.length} products and research projects by Sina Dehesh — ${publishedCaseStudies
  .slice(0, 4)
  .map((c) => c.name)
  .join(", ")} and more — with behavioral mechanisms, trade-offs and decision logs.`;
---

<Layout
  title={title}
  description={description}
  jsonLd={[
    {
      "@type": "CollectionPage",
      "@id": absoluteUrl("/work/"),
      url: absoluteUrl("/work/"),
      name: title,
      description,
      hasPart: publishedCaseStudies.map((c) => ({ "@id": absoluteUrl(`${caseStudyPath(c.slug)}#work`) })),
    },
    breadcrumbNode([
      { name: "Home", path: "/" },
      { name: "Case studies", path: "/work/" },
    ]),
    ...allCaseStudyNodes(),
  ]}
>
  <GlassHeader client:load />
  <main class="min-h-screen pt-6">
    <CaseStudyGrid as="h1" />
  </main>
  <Footer />
</Layout>
