---
import Layout from "@/layouts/Layout.astro";
import GlassHeader from "@/components/GlassHeader";
import Hero from "@/components/Hero.astro";
import HireSina from "@/components/HireSina.astro";
import ProblemMatrix from "@/components/ProblemMatrix.astro";
import CaseStudyGrid from "@/components/CaseStudyGrid.astro";
import ExperienceSection from "@/components/ExperienceSection";
import SkillsSection from "@/components/SkillsSection";
import EducationSection from "@/components/EducationSection";
import FaqSection from "@/components/FaqSection.astro";
import Footer from "@/components/Footer.astro";
import { faqs } from "@/lib/faq";
import { allCaseStudyNodes, profilePageNode } from "@/lib/schema";
---

<Layout ogType="profile" jsonLd={[profilePageNode(), ...allCaseStudyNodes()]}>
  <GlassHeader client:load />
  <main class="min-h-screen">
    <Hero />
    <HireSina />
    <ProblemMatrix />
    <CaseStudyGrid />
    <ExperienceSection client:visible />
    <SkillsSection client:visible />
    <EducationSection client:visible />
    <FaqSection items={faqs.filter((f) => f.featured)} moreHref="/capabilities/" />
  </main>
  <Footer />
</Layout>
