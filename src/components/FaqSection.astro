---
import { getCaseStudy } from "@/lib/data";
import type { FaqItem } from "@/lib/faq";
import { caseStudyPath } from "@/lib/schema";

interface Props {
  items: FaqItem[];
  title?: string;
  /** Link to the full FAQ, shown when rendering a subset. */
  moreHref?: string;
}

const {
  items,
  title = "Behavioral product design & AI prototyping: frequently asked questions",
  moreHref,
} = Astro.props;
---

<section id="faq" class="py-12 scroll-mt-20" aria-labelledby="faq-heading">
  <div class="container max-w-4xl mx-auto px-4">
    <h2 id="faq-heading" class="text-2xl md:text-3xl font-bold mb-6">{title}</h2>
    <div class="divide-y divide-border/60 rounded-xl border border-border/60 bg-background/80">
      {
        items.map((f) => (
          <details class="group p-5" open>
            <summary class="cursor-pointer list-none flex justify-between gap-4">
              <h3 class="font-semibold">{f.question}</h3>
              <span aria-hidden="true" class="text-purple-500 transition-transform group-open:rotate-45">+</span>
            </summary>
            <p class="mt-3 text-muted-foreground">{f.answer}</p>
            <p class="mt-2 text-sm">
              <span class="font-medium">See: </span>
              {f.proof
                .map((slug) => getCaseStudy(slug))
                .filter((c) => c !== undefined)
                .map((c, i) => (
                  <>{i > 0 && ", "}<a class="text-purple-600 dark:text-purple-400 underline underline-offset-2" href={caseStudyPath(c.slug)}>{c.name}</a></>
                ))}
            </p>
          </details>
        ))
      }
    </div>
    {
      moreHref && (
        <p class="mt-4 text-sm">
          <a class="font-medium text-purple-600 dark:text-purple-400 underline underline-offset-2" href={moreHref}>
            All capability questions and the full skills matrix →
          </a>
        </p>
      )
    }
  </div>
</section>
