---
import { publishedCaseStudies } from "@/lib/data";
import { caseStudyPath } from "@/lib/schema";

interface Props {
  /** Heading level for the section title (h1 on /work/, h2 on the homepage). */
  as?: "h1" | "h2";
}

const { as: Heading = "h2" } = Astro.props;
---

<section id="work" class="py-12 scroll-mt-20" aria-labelledby="work-heading">
  <div class="container max-w-5xl mx-auto px-4">
    <Heading id="work-heading" class="text-2xl md:text-3xl font-bold mb-3">
      What AI and behavioral products has Sina Dehesh shipped?
    </Heading>
    <p class="text-muted-foreground mb-8 max-w-3xl">
      Every product starts from a behavioral hypothesis and ends in a system that measures it. Each case study opens with an
      executive impact summary, then the trade-offs and the decision log behind the build.
    </p>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
      {
        publishedCaseStudies.map((c) => (
          <article class="group flex flex-col rounded-xl border border-border/60 bg-background/80 overflow-hidden hover:border-purple-500/40 transition-colors">
            {c.image && (
              <img
                src={c.image}
                alt={`${c.name} product screenshot`}
                loading="lazy"
                width="800"
                height="500"
                class="aspect-[16/10] w-full object-cover"
              />
            )}
            <div class="p-5 flex flex-col flex-1">
              <p class="text-xs font-medium uppercase tracking-wider text-purple-600 dark:text-purple-400">
                {c.category} · {c.status}
              </p>
              <h3 class="text-xl font-semibold mt-1">
                <a href={caseStudyPath(c.slug)} class="hover:text-purple-600 dark:hover:text-purple-400">
                  {c.name}: {c.tagline}
                </a>
              </h3>
              <p class="text-sm text-muted-foreground mt-2 flex-1">{c.summary}</p>
              <dl class="mt-4 grid grid-cols-3 gap-2">
                {c.metrics.slice(0, 3).map((m) => (
                  <div class="rounded-md bg-muted/60 p-2">
                    <dt class="sr-only">{m.label}</dt>
                    <dd class="text-sm font-semibold">{m.value}</dd>
                    <dd class="text-[11px] leading-tight text-muted-foreground">{m.label}</dd>
                  </div>
                ))}
              </dl>
              <div class="mt-4 flex flex-wrap gap-4 text-sm font-medium">
                <a href={caseStudyPath(c.slug)} class="text-purple-600 dark:text-purple-400 underline underline-offset-2">
                  Read the {c.name} case study
                </a>
                {c.url && (
                  <a href={c.url} target="_blank" rel="noopener" class="text-muted-foreground hover:text-foreground">
                    Open live product ↗
                  </a>
                )}
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
