---
import { personalInfo } from "@/lib/data";

const links = [
  { href: "/work/", label: "Case studies" },
  { href: "/capabilities/", label: "Capabilities & FAQ" },
  { href: `mailto:${personalInfo.email}`, label: "Email" },
  { href: personalInfo.github, label: "GitHub" },
  { href: personalInfo.linkedin, label: "LinkedIn" },
  { href: "/llms.txt", label: "llms.txt" },
].filter((l) => l.href);
---

<footer class="border-t border-purple-500/10 py-8 bg-gradient-to-b from-background to-muted/20">
  <div class="container max-w-4xl mx-auto px-4 flex flex-col md:flex-row gap-4 justify-between items-center text-sm text-muted-foreground">
    <p class="text-center md:text-left">
      &copy; {new Date().getFullYear()} {personalInfo.name} · {personalInfo.headline} · {personalInfo.location}
    </p>
    <nav aria-label="Footer">
      <ul class="flex flex-wrap justify-center gap-x-4 gap-y-2">
        {links.map((l) => <li><a class="hover:text-foreground" href={l.href}>{l.label}</a></li>)}
      </ul>
    </nav>
  </div>
</footer>
