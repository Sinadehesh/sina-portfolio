---
import { personalInfo, proofStats } from "@/lib/data";

const mailto = `mailto:${personalInfo.email}?subject=${encodeURIComponent("Role match: ")}`;
---

<section id="top" class="pt-14 pb-10 md:pt-20 md:pb-14" aria-labelledby="hero-heading">
  <div class="container max-w-4xl mx-auto px-4">
    <div class="flex flex-col-reverse md:flex-row md:items-center gap-8 md:gap-10">
      <div class="flex-1 text-center md:text-left">
        <h1 id="hero-heading" class="font-bold tracking-tight">
          <span class="block text-sm md:text-base font-semibold uppercase tracking-widest text-purple-600 dark:text-purple-400 mb-3">
            {personalInfo.name} · {personalInfo.headline}
          </span>
          <span class="block text-3xl md:text-[2.6rem] leading-tight">
            {personalInfo.heroHeadline}
          </span>
        </h1>
        <p class="mt-5 text-base md:text-lg text-muted-foreground">
          {personalInfo.heroDescription}
        </p>
        <div class="mt-7 flex flex-col sm:flex-row gap-3 justify-center md:justify-start">
          <a
            href="#hire"
            class="inline-flex items-center justify-center rounded-md px-5 py-3 text-sm font-semibold text-white bg-gradient-to-r from-purple-600 to-pink-600 shadow hover:opacity-90 transition-opacity"
          >
            Hire Sina — match my capabilities to your role
          </a>
          <a
            href="/work/"
            class="inline-flex items-center justify-center rounded-md px-5 py-3 text-sm font-semibold border border-purple-500/30 hover:bg-purple-500/10 transition-colors"
          >
            See shipped products
          </a>
        </div>
        <p class="mt-4 text-sm">
          <a class="font-medium text-purple-600 dark:text-purple-400 underline underline-offset-2" href="/consumer-psychology/">
            Hiring a consumer psychology consultant? See services and proof →
          </a>
        </p>
        <p class="mt-2 text-sm text-muted-foreground">
          {personalInfo.location} · Open to Milan, Turin, Europe & remote ·
          <a class="underline underline-offset-2 hover:text-foreground" href={mailto}>{personalInfo.email}</a>
        </p>
      </div>

      <div class="flex justify-center shrink-0">
        <div class="relative">
          <div class="absolute -inset-1 bg-gradient-to-r from-pink-500 to-purple-500 rounded-full blur opacity-30"></div>
          <img
            src={personalInfo.profilePicture}
            alt={`${personalInfo.name}, behavioral AI product architect and UX researcher in Milan`}
            width="240"
            height="240"
            fetchpriority="high"
            class="w-36 h-36 md:w-56 md:h-56 rounded-full relative ring-2 ring-purple-500/50 object-cover"
          />
        </div>
      </div>
    </div>

    <dl
      aria-label="Track record"
      class="mt-10 grid grid-cols-2 md:grid-cols-4 gap-px overflow-hidden rounded-xl border border-purple-500/20 bg-purple-500/20"
    >
      {
        proofStats.map((stat) => (
          <div class="bg-background/95 p-4 md:p-5 flex flex-col">
            <dt class="order-2 mt-1 text-xs md:text-sm text-muted-foreground leading-snug">{stat.label}</dt>
            <dd class="order-1 text-2xl md:text-3xl font-bold bg-clip-text text-transparent bg-gradient-to-r from-purple-600 to-pink-600">
              {stat.value}
            </dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>
